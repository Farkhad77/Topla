# ---------------------------------------------------------------------------
# Dev-də bu BOŞ qalmalıdır. Boş olanda frontend nisbi `/api/...` sorğusu göndərir,
# Vite isə onu VITE_API_PROXY_TARGET-ə ötürür — beləliklə hər şey eyni origin-də
# qalır və brauzer Authorization başlığını silmir.
# Bura mütləq (absolute) ünvan yazma: cross-origin olsa token itə bilər.
VITE_API_BASE_URL=

# Backend-in ünvanı. Visual Studio-da hansı profili işə saldığından asılıdır:
#   http  profili  -> http://localhost:5077
#   https profili  -> https://localhost:7171
VITE_API_PROXY_TARGET=http://localhost:5077

# Şəkillərin host-u; boşdursa VITE_API_PROXY_TARGET istifadə olunur
VITE_MEDIA_BASE_URL=
