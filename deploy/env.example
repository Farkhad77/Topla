# ============================================================
# Arenio production sirləri.
# BU FAYLI deploy/.env ADI İLƏ KOPYALA və dəyərləri doldur:
#   cp deploy/env.example deploy/.env
# deploy/.env HEÇ VAXT git-ə düşməməlidir (.gitignore-a əlavə et).
# Compose belə işə salınır:
#   docker compose --env-file deploy/.env up -d --build
# ============================================================

# Saytın xarici ünvanı. Hələlik IP ilə (domen alanda https://domen ilə əvəzlə):
PUBLIC_URL=http://SERVER_IP_BURA

# Güclü DB parolu yarat: openssl rand -base64 24
POSTGRES_PASSWORD=DEYIS_MENI

# RabbitMQ üçün guest/guest İŞLƏTMƏ:
RABBITMQ_USER=arenio
RABBITMQ_PASSWORD=DEYIS_MENI

# YENİ JWT açarı yarat (köhnəsi git tarixçəsindədir, istifadə etmə!):
#   openssl rand -base64 48
JWT_SECRET=DEYIS_MENI_MINIMUM_48_SIMVOL

# SMTP (Gmail app password — köhnəsi git-ə düşübsə, Google-da ləğv edib yenisini yarat)
SMTP_FROM=senin@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=senin@gmail.com
SMTP_PASS=gmail_app_password
